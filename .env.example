# Copy to .env and fill in. .env must never be committed.

MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/CareerSandboxDB?appName=Cluster0
PORT=8000
JWT_SECRET=<any long random string>

# routes/experienceChat.js calls OpenAI directly. Without these the endpoint
# returns 503 and the form-based flow still works.
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini
