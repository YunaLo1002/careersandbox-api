# Copy to .env and fill in. .env must never be committed.

MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/CareerSandboxDB?appName=Cluster0
PORT=8000
JWT_SECRET=<any long random string>

# routes/experienceChat.js calls OpenAI directly. Without these the endpoint
# returns 503 and the form-based flow still works.
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# routes/interviewTranscribe.js. Keep whisper-1 unless the model team says
# otherwise: the other transcription models return no timestamps.
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# Set to 1 to log raw and cleaned transcripts (writes answers into the log).
# TRANSCRIBE_LOG_TEXT=0
